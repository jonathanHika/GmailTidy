<Window x:Class="GmailTidy.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GmailTidy" Height="450" Width="800">
    <ScrollViewer>
    <StackPanel Margin="10">
        <Button Name="AuthorizeButton" Content="Authorize" Click="Authorize_Click" Margin="0,5"/>
        <Button Name="PurgeButton" Content="Purge Social/Promotions" Click="Purge_Click" Margin="0,5"/>
        <Button Name="TrashFilterButton" Content="Create Trash Filter" Click="TrashFilter_Click" Margin="0,5"/>
        <Button Name="KeeperFiltersButton" Content="Create Keeper Filters" Click="KeeperFilters_Click" Margin="0,5"/>
        <Button Name="ScheduleButton" Content="Schedule Daily Run" Click="Schedule_Click" Margin="0,5"/>
        <Button Name="AnalyzeButton" Content="Analyze Engagement" Click="Analyze_Click" Margin="0,5"/>
        <Button Name="ClassifyOnceButton" Content="Classify Once" Click="ClassifyOnce_Click" Margin="0,5"/>
        <TextBox Name="OutputBox" Margin="0,10" Height="200" VerticalScrollBarVisibility="Auto" IsReadOnly="True" TextWrapping="Wrap"/>
    </StackPanel>
    </ScrollViewer>
</Window>
